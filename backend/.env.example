# AI & LLM Integration
GROQ_API_KEY=
# Required for the Assistant/chat page's semantic search (embeddings). If
# unset, embeddings are disabled and every chat message gets a permanent
# "starting its engines" reply instead of an answer.
HF_TOKEN=

# Environment: "production" enables stricter defaults elsewhere (see
# ALLOW_OTP_IN_RESPONSE / SHOW_ERROR_DETAIL below). Defaults to "development".
ENVIRONMENT=development

# Fixed session-signing secret - required for real deployments. Without it,
# each server process mints its own random secret, so a restart logs out
# every user and a multi-instance deployment gets random 401s depending on
# which process handles a request. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Comma-separated browser origins allowed to call this API cross-origin.
# Only needed when the frontend is served from a different origin than the
# API (e.g. local Vite dev server). Defaults to the local dev origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Off by default regardless of ENVIRONMENT - each needs its own explicit
# opt-in. Never enable these in a real deployment.
ALLOW_OTP_IN_RESPONSE=false
SHOW_ERROR_DETAIL=false

# Local DB
STATS_DB_PATH=backend/stats.db

# SMTP Mail Settings for Real OTP Password Reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=
SMTP_PASSWORD=
# When true, a misconfigured/failing mailbox surfaces a real error to the
# user on forgot-password instead of a false "check your email".
REQUIRE_REAL_EMAIL=true

# IMAP Settings for fetching candidate emails
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# PostgreSQL Database Connection (optional - leave blank to use local SQLite)
POSTGRES_DATABASE_URL=
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=

# External Cloud Storage Provider (google, local) - defaults to local disk if unset
STORAGE_PROVIDER=local

# Google Drive Config (used when STORAGE_PROVIDER=google)
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
